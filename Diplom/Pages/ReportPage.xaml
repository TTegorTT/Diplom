<Page x:Class="Diplom.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="900"
      Title="Отчёты"
      Background="LightGray">

    <Page.Resources>
        <!-- Простой стиль для чередования строк DataGrid -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#f8f9fa"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" 
                BorderBrush="LightGray" BorderThickness="1"
                Padding="15" Margin="0,0,0,15">
            <TextBlock Text="Формирование отчётов" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Панель выбора типа отчёта и параметров -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" 
                BorderBrush="LightGray" BorderThickness="1"
                Padding="15" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Тип отчёта:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="ReportTypeCombo" Width="250" Height="30"
                          SelectionChanged="ReportTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="Медосмотр (истекает в ближайшие 30 дней)" IsSelected="True"/>
                    <ComboBoxItem Content="Аттестация (плановая дата приближается)"/>
                    <ComboBoxItem Content="Список сотрудников по отделу"/>
                </ComboBox>
                <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="DepartmentFilterCombo" Width="220" Height="30"
                          SelectionChanged="DepartmentFilterCombo_SelectionChanged">
                    <ComboBoxItem Content="Все отделы" IsSelected="True"/>
                </ComboBox>
                <Button x:Name="ExportBtn" Content="📥 Экспорт в Excel" 
                        Width="160" Height="35" Margin="30,0,0,0"
                        Background="White" BorderBrush="#27ae60" Foreground="#27ae60"
                        FontWeight="Bold" Cursor="Hand" Click="ExportBtn_Click"/>
            </WrapPanel>
        </Border>

        <!-- Таблица с результатами -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" 
                BorderBrush="LightGray" BorderThickness="1"
                Padding="10">
            <DataGrid x:Name="ReportGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Отдел" Binding="{Binding DepartmentName}" Width="*"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="*"/>
                    <DataGridTextColumn Header="Стаж" Binding="{Binding WorkExperience}" Width="Auto"/>
                    <DataGridTextColumn Header="Дата приёма" Binding="{Binding HireDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                    <DataGridTextColumn Header="Медосмотр до" Binding="{Binding MedicalExamDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                    <DataGridTextColumn Header="Аттестация до" Binding="{Binding CertificationDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                    <DataGridTextColumn Header="Нагрузка" Binding="{Binding PlannedHours}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>