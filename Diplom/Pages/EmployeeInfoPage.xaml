<Page x:Class="Diplom.Pages.EmployeeInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="700"
      Title="Информация о сотруднике"
      Background="LightGray">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка назад -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" 
                BorderBrush="LightGray" BorderThickness="1"
                Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Назад" Width="80" Height="30"
                        Background="White" BorderBrush="#3498db" Foreground="#3498db"
                        FontWeight="Bold" Cursor="Hand" Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="Информация о сотруднике" 
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Карточка сотрудника -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" 
                BorderBrush="LightGray" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Аватар и цветовой индикатор -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Image Source="/Assets/photomode_15032026_210909.png" 
                           Width="150" Height="150" Stretch="UniformToFill"
                           Margin="0,0,0,15"/>
                    <Border Width="20" Height="20" CornerRadius="10"
                            Background="{Binding Employee.LoadBrush}"
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Employee.LoadPercent, StringFormat={}{0}%}"
                               HorizontalAlignment="Center" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Детальная информация -->
                <ScrollViewer Grid.Column="1" Margin="15,0,0,0">
                    <StackPanel>
                        <!-- ФИО -->
                        <TextBlock Text="ФИО" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.FullName}" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- Отдел -->
                        <TextBlock Text="Отдел" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.DepartmentName}" FontSize="14" Margin="0,0,0,15"/>

                        <!-- Должность -->
                        <TextBlock Text="Должность" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.PositionName}" FontSize="14" Margin="0,0,0,15"/>

                        <!-- Тип занятости -->
                        <TextBlock Text="Тип занятости" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.EmploymentTypeName}" FontSize="14" Margin="0,0,0,15"/>

                        <!-- Стаж -->
                        <TextBlock Text="Стаж" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock FontSize="14" Margin="0,0,0,15">
                            <Run Text="{Binding Employee.WorkExperience, Mode=OneWay, TargetNullValue='—'}"/>
                            <Run Text=" лет"/>
                        </TextBlock>

                        <!-- Дата приёма -->
                        <TextBlock Text="Дата приёма" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.HireDate, StringFormat=dd.MM.yyyy, TargetNullValue=—}" 
                                   FontSize="14" Margin="0,0,0,15"/>

                        <!-- Медосмотр -->
                        <TextBlock Text="Медосмотр до" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.MedicalExamDate, StringFormat=dd.MM.yyyy, TargetNullValue=—}" 
                                   FontSize="14" Margin="0,0,0,15"/>

                        <!-- Аттестация (расчётная) -->
                        <TextBlock Text="Следующая аттестация" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Employee.CertificationDate, StringFormat=dd.MM.yyyy, TargetNullValue=—}" 
                                   FontSize="14" Margin="0,0,0,15"/>

                        <!-- Нагрузка (план) -->
                        <TextBlock Text="Плановая нагрузка (часов)" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock FontSize="14" Margin="0,0,0,5">
                            <Run Text="{Binding Employee.PlannedHours, Mode=OneWay, TargetNullValue='—'}"/>
                            <Run Text=" ч"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Employee.LoadPercent, StringFormat='Загрузка: {0}%'}" 
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding Employee.LoadBrush}"/>

                        <!-- Фактическая нагрузка -->
                        <TextBlock Text="Фактически проведено (часов)" FontSize="12" Foreground="Gray" Margin="0,15,0,2"/>
                        <TextBlock FontSize="14">
                            <Run Text="{Binding Employee.ActualHours, Mode=OneWay, TargetNullValue='—'}"/>
                            <Run Text=" ч"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>