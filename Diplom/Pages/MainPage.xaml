<Page x:Class="Diplom.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="530" d:DesignWidth="900"
      Title="MainPage"
      Background="LightGray">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Левая колонка: KPI и быстрые действия -->
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
            <!-- KPI блок -->
            <Border Background="White" CornerRadius="8" 
                    BorderBrush="LightGray" BorderThickness="1"
                    Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Общая статистика" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Всего сотрудников -->
                        <Border Grid.Row="0" Grid.Column="0" 
                                Background="#f0f4f8" CornerRadius="6" 
                                Padding="15" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Всего" FontSize="13" Foreground="Gray"/>
                                <TextBlock x:Name="TotalEmployeesText" FontSize="26" FontWeight="Bold" 
                                           Foreground="#2980b9"/>
                            </StackPanel>
                        </Border>

                        <!-- Перегрузка -->
                        <Border Grid.Row="0" Grid.Column="1" 
                                Background="#f0f4f8" CornerRadius="6" 
                                Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Перегрузка" FontSize="13" Foreground="Gray"/>
                                <TextBlock x:Name="OverloadedText" FontSize="26" FontWeight="Bold" 
                                           Foreground="#e74c3c"/>
                            </StackPanel>
                        </Border>

                        <!-- Недогрузка -->
                        <Border Grid.Row="1" Grid.Column="0" 
                                Background="#f0f4f8" CornerRadius="6" 
                                Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Недогрузка" FontSize="13" Foreground="Gray"/>
                                <TextBlock x:Name="UnderloadedText" FontSize="26" FontWeight="Bold" 
                                           Foreground="#f39c12"/>
                            </StackPanel>
                        </Border>

                        <!-- Норма -->
                        <Border Grid.Row="1" Grid.Column="1" 
                                Background="#f0f4f8" CornerRadius="6" 
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="Норма" FontSize="13" Foreground="Gray"/>
                                <TextBlock x:Name="NormalText" FontSize="26" FontWeight="Bold" 
                                           Foreground="#27ae60"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Быстрые действия -->
            <Border Background="White" CornerRadius="8" 
                    BorderBrush="LightGray" BorderThickness="1"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Быстрые действия" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Button Content="Сотрудники" 
                            Height="40" FontSize="14" Background="White" 
                            BorderBrush="#3498db" BorderThickness="1"
                            Foreground="#3498db" FontWeight="Bold" Cursor="Hand"
                            Margin="0,0,0,10" Click="EmployeesButton_Click"/>
                    <Button Content="Отчёты" Margin="0,0,0,10"
                            Height="40" FontSize="14" Background="White" 
                            BorderBrush="#3498db" BorderThickness="1"
                            Foreground="#3498db" FontWeight="Bold" Cursor="Hand"
                            Click="ReportsButton_Click"/>
                    <Button Content="Импорт из 1С" Height="40" FontSize="14"
                            Background="White" BorderBrush="#e67e22" BorderThickness="1"
                            Foreground="#e67e22" FontWeight="Bold" Cursor="Hand"
                            Click="ImportButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Правая колонка: загрузка по отделам -->
        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
                Background="White" CornerRadius="8" 
                BorderBrush="LightGray" BorderThickness="1"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Загрузка по отделам" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DepartmentLoadList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DepartmentName}" Width="180" 
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LoadPercent, StringFormat={}{0}%}" 
                                                   Width="60" FontSize="13" Foreground="Gray" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CountText}" FontSize="13" 
                                                   Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Прогресс-бар -->
                                    <ProgressBar Grid.Row="1" Height="18" 
                                                 Value="{Binding LoadPercent}" 
                                                 Foreground="{Binding BarColor}" 
                                                 Background="#ecf0f1" 
                                                 BorderBrush="LightGray" BorderThickness="1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>